APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=example_app
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# Local: sync runs queued jobs immediately (still blocks on large video compress).
# Production: database + `php artisan queue:work` (see UPLOAD_VIDEO_COMPRESS_ASYNC below).
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Set both to true when you want upload compression again.
UPLOAD_IMAGE_COMPRESSION=false
UPLOAD_VIDEO_COMPRESSION=false
# Full path if ffmpeg is not on PATH, e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
UPLOAD_VIDEO_CRF=28
UPLOAD_VIDEO_PRESET=fast
UPLOAD_VIDEO_MAX_HEIGHT=1080
# Max video upload size in MB (3072 = 3 GB). PHP post/upload limits must match.
UPLOAD_MAX_VIDEO_MB=3072
# Factsheet highlight row videos only; 0 = no duration limit
UPLOAD_HIGHLIGHT_VIDEO_MAX_SECONDS=10
# Queue ffmpeg after upload (recommended for production). Requires QUEUE_CONNECTION=database or redis and a worker.
UPLOAD_VIDEO_COMPRESS_ASYNC=true
# Only when UPLOAD_VIDEO_COMPRESS_ASYNC=false: sync compress files up to this size (MB); 0 = always sync.
UPLOAD_VIDEO_COMPRESS_SYNC_MAX_MB=0
